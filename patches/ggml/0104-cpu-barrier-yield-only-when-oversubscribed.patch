+    // Yield only when the threads outnumber the CPUs this process may use: the
+    // self-oversubscription the yield exists for. Otherwise the yield hands the
+    // core to other processes' threads, and the waiter can lose a whole time
+    // slice at every barrier, which made inference several times slower on a
+    // machine loaded by other work; a pause-spin keeps the core.
+    const bool may_yield = n_threads > tp->n_cpus;
     int spin = 0;
     while (atomic_load_explicit(&tp->n_barrier_passed, memory_order_relaxed) == n_passed) {
-        if (++spin < GGML_BARRIER_SPIN_BEFORE_YIELD) {
+        if (!may_yield || ++spin < GGML_BARRIER_SPIN_BEFORE_YIELD) {
             ggml_thread_cpu_relax();
         } else {
             // Bounded pause-spin elapsed without release: yield so a worker that
@@ -3382,6 +3418,7 @@ static struct ggml_threadpool * ggml_threadpool_new_impl(
         threadpool->n_threads        = tpp->n_threads;
         threadpool->poll             = tpp->poll;
         threadpool->prio             = tpp->prio;
+        threadpool->n_cpus           = ggml_cpu_count_usable();
         threadpool->ec               = GGML_STATUS_SUCCESS;
     }
 
