diff --git a/src/ggml-vulkan/vulkan-shaders/dequant_tq1_g128.comp b/src/ggml-vulkan/vulkan-shaders/dequant_tq1_g128.comp
new file mode 100644
index 00000000..ef14e492
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/dequant_tq1_g128.comp
@@ -0,0 +1,27 @@
+#version 450
+
+#include "dequant_head.glsl"
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {block_tq1_g128 data_a[];};
+layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x * 4;
+
+    if (i >= p.nel) {
+        return;
+    }
+
+    const uint ib = i / QUANT_K_TQ1_G128;
+
+    [[unroll]] for (uint j = 0; j < 4 && (i + j) < p.nel; ++j) {
+        const uint e = (i + j) % QUANT_K_TQ1_G128;
+        const uint bidx = tq1_g128_byte_of(e);
+        const uint qbyte = uint(bidx < 48u ? data_a[ib].qs[bidx]
+                                           : data_a[ib].qh[bidx - 48u]);
+        const uint xi = tq1_0_trit(qbyte, tq1_g128_digit_of(e));
+        data_b[i + j] = D_TYPE(float(data_a[ib].d[e >> 7u]) * (float(xi) - 1.0f));
+    }
+}
