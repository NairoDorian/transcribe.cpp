+void dequantize_row_tq1_g128(const block_tq1_g128 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_K == 0);
+    const uint8_t pow3[5] = {1, 3, 9, 27, 81};
+    for (int64_t i = 0; i < k / QK_K; ++i) {
