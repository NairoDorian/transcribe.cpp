// Generated Windows resource script — embeds VS_VERSION_INFO into
// transcribe.dll so the build version is viewable via file Properties >
// Details (right-click the DLL) without loading it. Generated by CMake from
// cmake/transcribe-version.rc.in.
//
// Numeric FILEVERSION is derived directly from TRANSCRIBE_VERSION_MAJOR/MINOR/
// PATCH (already integers parsed in CMakeLists.txt) — no describe-parse
// fallback needed. The string fields carry the full provenance.
#include <winver.h>

#define VER_FILEVERSION             @TRANSCRIBE_RC_FILEVERSION@
#define VER_FILEVERSION_STR         "@TRANSCRIBE_VERSION@\0"
#define VER_PRODUCTVERSION          @TRANSCRIBE_RC_FILEVERSION@
#define VER_PRODUCTVERSION_STR      "@TRANSCRIBE_VERSION@\0"

1 VERSIONINFO
FILEVERSION    VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // LangID 0x0409 (en-US), CodePage 0x04B0 (UTF-16LE)
        BEGIN
            VALUE "CompanyName",      "transcribe.cpp\0"
            VALUE "FileDescription",  "transcribe.cpp native inference library\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "transcribe\0"
            VALUE "OriginalFilename", "transcribe.dll\0"
            VALUE "ProductName",      "transcribe.cpp\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            // Full provenance in Comments so a single field carries everything:
            // version | commit | branch | build date | build backend.
            VALUE "Comments",         "transcribe.cpp | @TRANSCRIBE_VERSION@ | @TRANSCRIBE_BUILD_COMMIT@ | @TRANSCRIBE_BUILD_BRANCH@ | @TRANSCRIBE_BUILD_DATE@ | @TRANSCRIBE_BUILD_BACKEND@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
